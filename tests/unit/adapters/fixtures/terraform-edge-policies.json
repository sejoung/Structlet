          "values": {
            "web_acl_id": "arn:aws:wafv2:us-east-1:000000000000:global/webacl/example/acl",
            "default_cache_behavior": [{
              "target_origin_id": "website",
              "cache_policy_id": "policy-custom",
              "default_ttl": 99999,
              "viewer_protocol_policy": "redirect-to-https",
              "allowed_methods": ["GET", "HEAD", "OPTIONS"],
              "compress": true
