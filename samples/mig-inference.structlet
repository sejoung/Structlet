  "annotations": [
    {
      "id": "mig-notes",
      "kind": "text",
      "text": "Each model is assigned a separate MIG instance on the same physical GPU.\nBoth instances use the 1g.5gb profile. Available profiles depend on the GPU.\nThe device plugin advertises GPU resources to Kubernetes; DCGM Exporter provides telemetry.",
      "x": 68,
      "y": 598,
      "targetId": null
    }
  ]
