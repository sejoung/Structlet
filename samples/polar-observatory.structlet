    {"id":"basalt-sampling-note","kind":"text","x":40,"y":5088,"text":"Sampling boundary\nClock error and calibration version are attached to each measurement.","targetId":"basalt-primary"},
    {"id":"tundra-sampling-note","kind":"text","x":40,"y":5164,"text":"Sampling boundary\nClock error and calibration version are attached to each measurement.","targetId":"tundra-primary"},
    {"id":"reef-sampling-note","kind":"text","x":40,"y":5240,"text":"Sampling boundary\nClock error and calibration version are attached to each measurement.","targetId":"reef-primary"},
    {"id":"fen-sampling-note","kind":"text","x":40,"y":5316,"text":"Sampling boundary\nClock error and calibration version are attached to each measurement.","targetId":"fen-primary"},
    {"id":"quality-note","kind":"text","x":40,"y":5392,"text":"Quality control\nLow-confidence data goes to quarantine with the reason and calibration version.","targetId":"quality"},
    {"id":"recovery-note","kind":"text","x":40,"y":5468,"text":"Recovery envelope\nOnly verified snapshots are eligible for restoration.","targetId":"recovery"},
    {"id":"legend","kind":"legend","x":40,"y":5544,"text":"Synthetic example · Polar Observatory Network\n--- Observation and query paths\n- - Control actions and event signals","targetId":null},
    {"id":"portal-note","kind":"text","x":40,"y":5620,"text":"Publication schedule\nThe portal may serve cached map tiles while fresh observations are indexed.","targetId":"portal"},
    {"id":"survey-note","kind":"text","x":40,"y":5696,"text":"Field coordination\nHeartbeat and weather bulletins inform the survey schedule.","targetId":"schedule"},
    {"id":"mixed-label-note","kind":"text","x":40,"y":5772,"text":"분석 결과는 버전별로 보관합니다.\nAnalysis results can be queried by calibration version.","targetId":"datasets"}
